# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Or OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
PORT=3000
HOST=127.0.0.1
# Optional: force an output-token cap (unset = the model's own maximum)
#MAX_OUTPUT_TOKENS=
# Optional: override the cost estimate (USD per 1M tokens)
#PRICE_IN_PER_M=0.30
#PRICE_OUT_PER_M=2.50
# 0 = most repeatable results (default)
#TEMPERATURE=0
