# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Or OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
PORT=3000
HOST=127.0.0.1
# Optional: force an output-token cap (unset = the model's own maximum)
#MAX_OUTPUT_TOKENS=
# Optional: override the cost estimate (USD per 1M tokens)
#PRICE_IN_PER_M=0.30
#PRICE_OUT_PER_M=2.50
# 0 = most repeatable results (default)
#TEMPERATURE=0
# --- Public server (see DEPLOY.md). Setting APP_SECRET turns on login and the SSRF/CSRF protections.
# Without it the server only listens on loopback.
#APP_SECRET=<openssl rand -base64 24>
# Number of reverse proxies in front (nginx = 1) so the real client IP / HTTPS are known
#TRUST_PROXY=1
#MAX_PROJECTS=300
#MAX_IMAGES_PER_PROJECT=400
#LLM_CALLS_PER_MIN=90
# --- Images in Cloudflare R2 instead of the local disk (see DEPLOY.md). project.json stays in DATA_DIR.
#STORAGE=r2
#R2_ACCOUNT_ID=
#R2_BUCKET=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
# Any S3-compatible endpoint instead of R2_ACCOUNT_ID (MinIO, ...)
#R2_ENDPOINT=
